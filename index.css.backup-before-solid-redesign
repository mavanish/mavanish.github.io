.nav-links a:hover,
.nav-links a.active { background: transparent; box-shadow: none; }
/* Clear glass: shared surfaces expose the color field beneath every page. */
body {
    background:
        radial-gradient(ellipse at 5% 12%, rgba(105, 148, 255, .32), transparent 55%),
        radial-gradient(ellipse at 95% 40%, rgba(76, 210, 225, .25), transparent 55%),
        radial-gradient(ellipse at 48% 95%, rgba(177, 133, 244, .25), transparent 58%),
        #f5f8fe;
    background-attachment: fixed;
}
body.page-mode > .section,
.section:nth-child(even),
#hero { background: transparent; }

.liquid-glass,
.glass-card,
.research-card,
.publication-card,
.publication-panel,
.software-card,
.news-card,
.opening-row-header,
.contact-card,
.hero-glass,
.pillar,
.perk {
    background: linear-gradient(135deg, rgba(255,255,255,.24), rgba(255,255,255,.08));
    border-color: rgba(255,255,255,.56);
    backdrop-filter: blur(14px) saturate(135%);
    -webkit-backdrop-filter: blur(14px) saturate(135%);
    box-shadow: 0 14px 40px rgba(35,55,108,.09), inset 0 1px 0 rgba(255,255,255,.65);
}
.glass-card::before,
.research-card::before,
.publication-card::before,
.software-card::before,
.news-card::before,
.opening-row-header::before,
.contact-card::before,
.pillar::after,
.perk::after {
    background: linear-gradient(125deg, rgba(255,255,255,.16), transparent 32%, transparent 78%, rgba(255,255,255,.06));
}
#navbar,
#navbar.scrolled { background: rgba(255,255,255,.22); }
.btn-secondary,
.section-tag,
.hero-social a { background: rgba(255,255,255,.22); }
/* Nested cards need less tint to avoid accumulating opaque white layers. */
.publication-card { background: rgba(255,255,255,.10); }
.impact-banner { background: linear-gradient(135deg, rgba(0,10,88,.85), rgba(32,48,168,.70)); }
.modal-content { background: rgba(241,247,255,.86); }
@media (max-width: 900px) {
    .mobile-nav { background: rgba(241,247,255,.85); }
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-card, .research-card, .pillar, #navbar { background-color: rgba(245,249,255,.85); }
}
