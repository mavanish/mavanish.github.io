    }

    .hero-cta {
        justify-content: center;
    }

    .hero-social {
        justify-content: center;
    }

    .hero-tagline {
        margin-left: auto;
        margin-right: auto;
    }

    /* Hide scroll indicator on mobile to prevent overlap with social icons */
    .scroll-indicator {
        display: none;
    }

    .quantum-orb {
        width: 220px;
        height: 220px;
    }

    .orb-core {
        width: 55px;
        height: 55px;
    }

    .ring-1 {
        width: 120px;
        height: 120px;
        margin: -60px 0 0 -60px;
    }

    .ring-2 {
        width: 170px;
        height: 170px;
        margin: -85px 0 0 -85px;
    }

    .ring-3 {
        width: 220px;
        height: 220px;
        margin: -110px 0 0 -110px;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .nav-links {
        display: none;
    }

    #navToggle {
        display: flex;
    }

    .impact-banner {
        flex-direction: column;
        text-align: center;
        gap: 1.5rem;
        padding: 2rem;
    }

    .impact-banner .btn-primary {
