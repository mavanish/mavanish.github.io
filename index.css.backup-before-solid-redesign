    padding: 2.5rem 3rem;
    margin-bottom: 4rem;
}

.publication-panel {
    padding: 2rem;
    margin-bottom: 4rem;
    border-radius: 14px;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(240, 253, 250, 0.74)),
        linear-gradient(rgba(0, 102, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 102, 255, 0.05) 1px, transparent 1px);
    background-size: auto, 28px 28px, 28px 28px;
}

.publication-panel:hover {
    transform: none;
}

.publication-toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
}

.publication-toolbar h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
}

.publication-search {
    display: flex;
