    .research-grid .research-card:nth-child(4),
    .research-grid .research-card:nth-child(5) {
        grid-column: auto;
    }
}

/* ---------- FLOATING GLASS MENU ---------- */
#navbar::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(110deg, rgba(255,255,255,.42), transparent 38%, rgba(111,185,255,.10));
}

.nav-links a {
    isolation: isolate;
    overflow: hidden;
}

.nav-links a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    transform: scale(.72);
    background: linear-gradient(145deg, rgba(255,255,255,.92), rgba(218,229,255,.55));
    border: 1px solid rgba(255,255,255,.95);
    box-shadow: 0 7px 18px rgba(42,66,145,.13), inset 0 1px rgba(255,255,255,1);
    transition: opacity .25s ease, transform .35s cubic-bezier(.2,.8,.2,1);
}

.nav-links a:hover::before,
.nav-links a.active::before { opacity: 1; transform: scale(1); }
.nav-links a:hover,
.nav-links a.active { background: transparent; box-shadow: none; }

#navToggle { width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.9); box-shadow: 0 8px 22px rgba(31,47,100,.12); }
#navToggle span { transform-origin: center; }
#navToggle.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
